{
  "manifest_version": 3,
  "name": "Evidencias Matriz de Pruebas",
  "version": "2.0.0",
  "description": "Navega filas de un Excel local con la matriz de pruebas y guarda capturas como evidencia.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Abrir panel de pruebas" }
}
