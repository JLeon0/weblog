{
  "manifest_version": 3,
  "name": "Evidencias Matriz de Pruebas",
  "version": "1.0.0",
  "description": "Navega filas de una hoja de Google Sheets y pega capturas en la columna Evidencia.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "identity", "storage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>", "https://sheets.googleapis.com/*", "https://www.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Abrir panel de pruebas" },
  "oauth2": {
    "client_id": "REEMPLAZAR.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "icons": {}
}
